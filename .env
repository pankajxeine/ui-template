# Note: change in this file will require reload / rebuild.
# Note: prefix `REACT_APP_` is required.
NODE_ENV=local
GENERATE_SOURCEMAP=false

REACT_APP_CPANEL_ENDPOINT=http://localhost:5000/api

#REACT_APP_AWS_CPANEL_ROUTES_GATEWAY=https://ds-cpanelroutes.04partners-dev.com/cpanelroutes
REACT_APP_AWS_CPANEL_ROUTES_GATEWAY=http://localhost:5000/api/cpanelroutes

REACT_APP_OAUTH_DEFAULT_ENDPOINT=/login
REACT_APP_ROUTE_BASENAME=/
REACT_APP_TITLE=LiteCRM
REACT_APP_XDOMAIN=local-crm.04partners.com
REACT_APP_XINDUSTRY=crm
REACT_APP_PROTOCOL=http

#TO OVERRIDE ROLE BASE ACCESS CONTROL
REACT_APP_OVERRIDE_ROLE_PERMISSION=true

REACT_APP_CRYPTO_KEY=04partnersKey

#AXIOS CALL TIMEOUT
REACT_APP_AXIOS_MIN_TIMEOUT=30000 # 30 SECONDS
REACT_APP_AXIOS_MAX_TIMEOUT=300000 # 5 MINUTES

port=3007